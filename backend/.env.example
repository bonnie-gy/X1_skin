# ====================================
# X1 官网 - 环境变量配置模板
# ====================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ------------------------------------
# 邮件通知配置 (SMTP)
# ------------------------------------
# 收件人邮箱（收到咨询通知的邮箱，如未设置则使用 SMTP_USER）
CONTACT_EMAIL=hatchyoung@outlook.com

# SMTP 服务器配置
# Outlook/Hotmail 配置示例:
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@outlook.com
SMTP_PASS=your-app-password

# Gmail 配置示例（取消注释使用）:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# SendGrid 配置示例（取消注释使用）:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# QQ邮箱配置示例（取消注释使用）:
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-qq@qq.com
# SMTP_PASS=your-qq-smtp-code

# 网易163邮箱配置示例（取消注释使用）:
# SMTP_HOST=smtp.163.com
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_USER=your-email@163.com
# SMTP_PASS=your-authorization-code

# ------------------------------------
# Webhook 通知配置（可选）
# ------------------------------------
# 合作咨询提交后发送到 webhook 的 URL
# CONTACT_WEBHOOK_URL=https://your-webhook-url.com/webhook

# Webhook 认证 Token（如果 webhook 需要认证）
# CONTACT_WEBHOOK_TOKEN=your-webhook-token

# ------------------------------------
# 服务器配置
# ------------------------------------
# 端口号（默认 4173）
# PORT=4173

# 监听地址（默认 127.0.0.1）
# HOST=127.0.0.1
